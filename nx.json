{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals", "runtimeEnvironment"],
    "production": ["default", "!{projectRoot}/tests/**/*", "!{projectRoot}/vitest.config.ts"],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.js",
      "{workspaceRoot}/.prettierrc.json"
    ],
    "workspaceSkills": [
      "{workspaceRoot}/.codex/skills/**/*",
      "{workspaceRoot}/.claude/skills/**/*"
    ],
    "runtimeEnvironment": [
      { "runtime": "node --version" },
      { "runtime": "node -p process.platform" },
      { "runtime": "node -p process.arch" }
    ]
  }
}
